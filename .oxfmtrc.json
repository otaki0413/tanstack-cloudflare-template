{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/routeTree.gen.ts"],
  "sortImports": {
    "groups": [
      ["side_effect"],
      ["builtin"],
      ["external"],
      ["internal"],
      ["parent"],
      ["sibling"],
      ["index"],
      ["type"]
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "./src/styles.css",
    "attributes": ["className"]
  },
  "sortPackageJson": {
    "sortScripts": true
  }
}
